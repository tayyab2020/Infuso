// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  MEN
  WOMEN
  UNISEX
}

model Product {
  id       String          @id @default(cuid())
  slug     String          @unique
  name     String
  price    Int
  priceOld Int?
  stock    Int             @default(100)
  active   Boolean         @default(true)
  category ProductCategory @default(UNISEX)
  // Admin-set countdown deadline for the current priceOld/price discount —
  // shown as a "sale ends in" timer on the product page when set and still
  // in the future. Null hides the timer.
  saleEndsAt DateTime?

  // Images — all optional; storefront falls back to its hardcoded path when null.
  imageUrl               String?
  hoverImageUrl          String?
  editorialTallImageUrl  String?
  editorialWideImageUrl  String?
  // Which of the 4 image fields above is shown as the default image on the
  // storefront product page — one of 'imageUrl' | 'hoverImageUrl' | 'editorialTallImageUrl' | 'editorialWideImageUrl'.
  featuredImage           String          @default("imageUrl")

  // Text content — all optional; storefront falls back to its hardcoded copy when null/empty.
  tagline        String?
  topNote        String?
  heartNote      String?
  baseNote       String?
  description    String? @db.Text
  inspiredBy     String?
  editorialLine  String?
  editorialStory String? @db.Text

  // Product-page detail content — all optional; falls back to generic
  // storefront copy when null/empty, same as the other text fields above.
  concentration String?          // e.g. "Eau de Parfum · 20% oil concentration"
  longevity     String?          // e.g. "8–10 hours"
  howToUse      String? @db.Text
  ingredients   String? @db.Text

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
  reviews    Review[]
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id String @id @default("singleton")

  // Branding
  logoUrl String?

  // Social / contact
  facebookUrl    String?
  instagramUrl   String?
  contactEmail   String?
  whatsappNumber String?

  // Checkout
  deliveryCharge Int? @default(280)
  // "Only N left!" badge threshold — shown on a product page when its stock
  // is at or below this. Null disables the badge site-wide.
  lowStockThreshold Int? @default(5)

  // Bank transfer
  bankAccountName   String?
  bankName          String?
  bankAccountNumber String?
  bankIban          String?
  bankQrImageUrl    String?

  // Mail (text-only — HTML layout stays in src/orderEmails.js)
  mailFromName     String?
  mailFromAddress  String?
  codEmailSubject  String?
  codEmailIntro    String? @db.Text
  bankEmailSubject String?
  bankEmailIntro   String? @db.Text

  // Section intro copy
  houseEyebrow     String?
  houseHeading     String?
  houseBody        String? @db.Text
  editorialEyebrow String?
  editorialHeading String?
  editorialBody    String? @db.Text
  discoveryEyebrow String?
  discoveryHeading String?
  discoveryBody    String? @db.Text
  faqEyebrow       String?
  faqHeading       String?

  // Footer
  footerCopyright String?

  // Product-page policy copy — store-wide, shown on every product.
  deliveryInfo String? @db.Text
  returnPolicy String? @db.Text

  // Site-wide promotional campaign (e.g. a seasonal sale) — a single active
  // campaign, shown as an announcement bar on every page plus a badge/price
  // label/countdown on product pages. All purely presentational: it doesn't
  // change any actual pricing, which stays driven by each product's own
  // price/priceOld fields — this is a marketing layer on top of that.
  campaignActive         Boolean   @default(false)
  campaignLabel          String?   // e.g. "AZADI SALE" — used for the badge and banner prefix
  campaignPriceLabel     String?   // e.g. "AZADI PRICE" — shown beside a discounted price
  campaignEndsAt         DateTime?
  campaignThemeColor     String?   // e.g. "#4ADE80" — drives the banner/badge/countdown color
  campaignBannerContent  String?   @db.Text // full override for the announcement-bar line; when set, shown verbatim instead of the auto-composed label/endsAt line

  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  PAYMENT_RECEIVED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerName  String
  customerEmail String        @default("")
  phone         String
  address       String
  city          String
  notes         String?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  deliveryCharge Int          @default(280)
  // Snapshotted at checkout — kept even if the voucher is later edited/deleted,
  // so past orders keep showing what discount was actually applied.
  voucherCode    String?
  discountAmount Int          @default(0)
  totalAmount   Int
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Voucher {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  active          Boolean   @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int
  unitPrice   Int
  productName String
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Review {
  id           String  @id @default(cuid())
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  // The order this review was verified against — required for public
  // submissions (checked to actually contain this product), optional for
  // reviews the admin enters directly (e.g. imported from social media).
  orderNumber  String?
  customerName String
  rating       Int
  comment      String  @db.Text
  // How many of this product the customer's order included — admin-entered
  // record-keeping only (e.g. an order of 2x AETHER + 1x ARIA becomes two
  // review rows, one per product, each carrying its own quantity).
  quantity     Int      @default(1)
  // Ties together the multiple review rows created from one multi-product
  // admin submission (same customer/rating/comment, different products) so
  // the homepage's cross-product feed can show them as a single card instead
  // of one duplicate card per product. Null for single-product reviews.
  batchId      String?
  // Gates public visibility — nothing submitted through the public form is
  // shown until an admin approves it.
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId, approved])
}
